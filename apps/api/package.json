{
  "name": "@nuviora/api",
  "private": true,
  "scripts": {
    "dev": "tsc && concurrently \"tsc --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc && tsx --test test/security.test.ts test/phase2.unit.test.ts test/phase3.unit.test.ts",
    "test:integration": "tsc && tsx --test --test-concurrency=1 test/integration.test.ts test/phase2.integration.test.ts test/phase3.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nuviora/domain": "workspace:*",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "0.20.2",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "0.17.7",
    "concurrently": "^9.2.1",
    "pdf-parse": "2.4.5",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
