generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  ADMIN
  MEMBER
}
enum BusinessType {
  PRODUCTS
  SERVICES
  MIXED
}
enum TokenPurpose {
  VERIFY
  RESET
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  tokens AuthToken[]
  memberships Membership[]
  activities ActivityLog[]
  createdQuotes Quote[]
  quoteEvents QuoteEvent[]
  assignedOperations Operation[]
  createdPayments Payment[] @relation("PaymentCreator")
  reversedPayments Payment[] @relation("PaymentReverser")
  operationEvents OperationEvent[]
  sentInvitations Invitation[] @relation("InvitationSender")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  purpose TokenPurpose
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, purpose])
  @@index([expiresAt])
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  legalName String?
  rut String?
  email String
  phone String?
  country String @default("CL")
  currency String @default("CLP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  settings OrganizationSettings?
  activities ActivityLog[]
  customers Customer[]
  catalogItems CatalogItem[]
  quotes Quote[]
  quoteSequence QuoteSequence?
  quoteBranding QuoteBranding?
  operations Operation[]
  operationSequence OperationSequence?
  invitations Invitation[]
  subscription Subscription?
  address String? @db.VarChar(250)
  commune String? @db.VarChar(100)
  region String? @db.VarChar(100)
  timeZone String @default("America/Santiago") @db.VarChar(100)
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  role Role @default(MEMBER)
  deactivatedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, organizationId])
  @@index([organizationId])
}
model OrganizationSettings {
  organizationId String @id @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessType BusinessType @default(MIXED)
  hiddenModules String[] @default([])
  updatedAt DateTime @updatedAt
}
model ActivityLog {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorId String @db.Uuid
  action String
  metadata Json?
  resourceId String? @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
enum CustomerType {
  PERSON
  COMPANY
}
enum CatalogType {
  PRODUCT
  SERVICE
}
enum TaxMode {
  VAT_19
  EXEMPT
}
model Customer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type CustomerType
  name String @db.VarChar(150)
  rut String? @db.VarChar(12)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(30)
  address String? @db.VarChar(250)
  commune String? @db.VarChar(100)
  region String? @db.VarChar(100)
  country String @default("Chile") @db.VarChar(100)
  notes String? @db.VarChar(5000)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, archivedAt, type])
  @@index([organizationId, name, id])
  @@index([organizationId, rut])
  @@unique([id, organizationId])
  quotes Quote[]
  operations Operation[]
}
model CatalogItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type CatalogType
  name String @db.VarChar(150)
  sku String? @db.VarChar(60)
  description String? @db.VarChar(5000)
  unitPrice Decimal @db.Decimal(18, 2)
  unit String @db.VarChar(50)
  taxMode TaxMode @default(VAT_19)
  active Boolean @default(true)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt, active, type])
  @@index([organizationId, name, id])
  @@unique([id, organizationId])
  quoteItems QuoteItem[]
  operationItems OperationItem[]
}
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}
enum QuoteDecision {
  APPROVED
  REJECTED
}
enum QuoteEventType {
  CREATED
  EDITED
  SENT
  LINK_CREATED
  LINK_REVOKED
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  DUPLICATED
  FOLLOW_UP
  CONVERTED
}
model QuoteSequence {
  organizationId String @id @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lastNumber Int @default(0)
}
model QuoteBranding {
  organizationId String @id @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  logoDataUrl String? @db.Text
  accentColor String @default("#7759A6") @db.VarChar(7)
  footer String @default("") @db.VarChar(250)
  updatedAt DateTime @updatedAt
}
model Quote {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  number String @db.VarChar(30)
  status QuoteStatus @default(DRAFT)
  documentVersion Int @default(1)
  documentHash String? @db.VarChar(64)
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  issueDate DateTime @db.Date
  expiryDate DateTime @db.Date
  expiryAt DateTime
  currency String @default("CLP") @db.VarChar(3)
  reference String? @db.VarChar(150)
  customerName String @db.VarChar(150)
  subtotal Decimal @db.Decimal(18, 2)
  discountTotal Decimal @db.Decimal(18, 2)
  taxableBase Decimal @db.Decimal(18, 2)
  exemptBase Decimal @db.Decimal(18, 2)
  netTotal Decimal @db.Decimal(18, 2)
  taxTotal Decimal @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  notes String? @db.VarChar(5000)
  deliveryTerms String? @db.VarChar(2000)
  paymentTerms String? @db.VarChar(2000)
  validityTerms String? @db.VarChar(1000)
  customerNotes String? @db.VarChar(5000)
  issuerSnapshot Json
  customerSnapshot Json
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items QuoteItem[]
  approval QuoteApproval?
  shareTokens QuoteShareToken[]
  events QuoteEvent[]
  operation Operation?
  @@unique([organizationId, number])
  @@unique([organizationId, requestKey])
  @@unique([id, organizationId])
  @@index([organizationId, status, expiryAt])
  @@index([organizationId, sentAt])
  @@index([organizationId, customerId, createdAt])
}
model QuoteItem {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  organizationId String @db.Uuid
  quote Quote @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  catalogItemId String? @db.Uuid
  catalogItem CatalogItem? @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name String @db.VarChar(150)
  description String? @db.VarChar(5000)
  unit String @db.VarChar(50)
  quantity Decimal @db.Decimal(12, 4)
  unitPrice Decimal @db.Decimal(18, 2)
  discount Decimal @db.Decimal(5, 2)
  taxMode TaxMode
  taxRate Decimal @db.Decimal(5, 2)
  subtotal Decimal @db.Decimal(18, 2)
  discountAmount Decimal @db.Decimal(18, 2)
  netAmount Decimal @db.Decimal(18, 2)
  taxAmount Decimal @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)
  position Int
  @@unique([quoteId, position])
  @@index([organizationId, quoteId])
  @@index([catalogItemId, organizationId])
}
model QuoteApproval {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @unique @db.Uuid
  organizationId String @db.Uuid
  quote Quote @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  documentVersion Int
  documentHash String @db.VarChar(64)
  decision QuoteDecision
  approverName String? @db.VarChar(120)
  reason String? @db.VarChar(1000)
  decidedAt DateTime @default(now())
  evidenceMetadata Json
  @@unique([quoteId, documentVersion])
  @@unique([quoteId, organizationId])
  @@index([organizationId])
}
model QuoteShareToken {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  organizationId String @db.Uuid
  quote Quote @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  documentVersion Int
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  lastViewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, quoteId, revokedAt])
  @@index([expiresAt])
}
model QuoteEvent {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  organizationId String @db.Uuid
  quote Quote @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  eventType QuoteEventType
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  @@index([organizationId, quoteId, createdAt])
}
enum OperationType {
  ORDER
  WORK
}
enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  OTHER
}
model OperationSequence {
  organizationId String @id @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lastNumber Int @default(0)
}
model Operation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customerName String @db.VarChar(150)
  customerSnapshot Json
  quoteId String? @unique @db.Uuid
  quote Quote? @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([quoteId, organizationId])
  number String @db.VarChar(30)
  type OperationType
  status OperationStatus @default(PENDING)
  version Int @default(1)
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  issueDate DateTime @db.Date
  dueDate DateTime? @db.Date
  assignedUserId String? @db.Uuid
  assignedUser User? @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)
  description String @db.VarChar(5000)
  instructions String? @db.VarChar(5000)
  internalNotes String? @db.VarChar(5000)
  subtotal Decimal @db.Decimal(18, 2)
  discountTotal Decimal @db.Decimal(18, 2)
  taxableBase Decimal @db.Decimal(18, 2)
  exemptBase Decimal @db.Decimal(18, 2)
  netTotal Decimal @db.Decimal(18, 2)
  taxTotal Decimal @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OperationItem[]
  payments Payment[]
  events OperationEvent[]
  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@unique([organizationId, requestKey])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, customerId, createdAt])
  @@index([assignedUserId, organizationId])
}
model OperationItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  operationId String @db.Uuid
  operation Operation @relation(fields: [operationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  catalogItemId String? @db.Uuid
  catalogItem CatalogItem? @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name String @db.VarChar(150)
  description String? @db.VarChar(5000)
  unit String @db.VarChar(50)
  quantity Decimal @db.Decimal(12,4)
  unitPrice Decimal @db.Decimal(18,2)
  discount Decimal @db.Decimal(5,2)
  taxMode TaxMode
  taxRate Decimal @db.Decimal(5,2)
  subtotal Decimal @db.Decimal(18,2)
  discountAmount Decimal @db.Decimal(18,2)
  netAmount Decimal @db.Decimal(18,2)
  taxAmount Decimal @db.Decimal(18,2)
  lineTotal Decimal @db.Decimal(18,2)
  position Int
  @@unique([operationId, position])
  @@index([organizationId, operationId])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  operationId String @db.Uuid
  operation Operation @relation(fields: [operationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  amount Decimal @db.Decimal(18,2)
  method PaymentMethod
  reference String? @db.VarChar(150)
  paidAt DateTime @db.Date
  notes String? @db.VarChar(2000)
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  createdById String @db.Uuid
  createdBy User @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  reversedAt DateTime?
  reversedById String? @db.Uuid
  reversedBy User? @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason String? @db.VarChar(1000)
  @@unique([organizationId, requestKey])
  @@unique([id, organizationId])
  @@index([organizationId, operationId, reversedAt])
  @@index([organizationId, paidAt])
}
model OperationEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  operationId String @db.Uuid
  operation Operation @relation(fields: [operationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  eventType String @db.VarChar(40)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  metadata Json
  createdAt DateTime @default(now())
  @@index([organizationId, operationId, createdAt])
}
enum SubscriptionPlan {
  EMPRENDE
  NEGOCIO
  EQUIPO
}
enum InvitationKind {
  MEMBER
  OWNERSHIP
}
model Subscription {
  organizationId String @id @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @default(EQUIPO)
  status String @default("UNCONFIGURED") @db.VarChar(30)
  renewalAt DateTime?
  provider String? @db.VarChar(100)
  providerSubscriptionId String? @db.VarChar(200)
  updatedAt DateTime @updatedAt
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email String @db.VarChar(254)
  role Role @default(MEMBER)
  kind InvitationKind @default(MEMBER)
  tokenHash String @unique @db.VarChar(64)
  createdById String @db.Uuid
  createdBy User @relation("InvitationSender", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt DateTime
  revokedAt DateTime?
  acceptedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, email, expiresAt])
  @@index([organizationId, createdAt])
}
